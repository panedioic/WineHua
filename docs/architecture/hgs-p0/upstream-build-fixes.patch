diff --git a/scripts/build_wayland.sh b/scripts/build_wayland.sh
index 51548e536..c6019ec61 100644
--- a/scripts/build_wayland.sh
+++ b/scripts/build_wayland.sh
@@ -80,7 +80,14 @@ ninja -C "$WL_BUILD/x86_64"
 # 安装 .so (文件名 = SONAME; 版本尾缀随 tag 变, glob 取实际产物, 取不到即失败)
 install_soname() {  # $1=产物 glob  $2=目标 SONAME 名
     local src
-    src=$(compgen -G "$1" | head -1 || true)
+    src=""
+    local candidate
+    while IFS= read -r candidate; do
+        if [ -f "$candidate" ]; then
+            src="$candidate"
+            break
+        fi
+    done < <(compgen -G "$1")
     [ -n "$src" ] || err "未找到产物: $1"
     cp "$src" "$SYSROOT_EXT_LIB/$2"
     log "installed $2 ← $(basename "$src")"
